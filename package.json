{
  "name": "lobo",
  "version": "1.0.0",
  "private": true,
  "description": "LOBO Club de Entrenamiento — Laravel 13 modular monolith and React TypeScript frontend",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santiagolobosilva20-cmd/LOBO.git"
  },
  "license": "MIT",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "preview:frontend": "npm --prefix frontend run preview",
    "test:frontend": "npm --prefix frontend test",
    "dev:backend": "php backend/artisan serve --host=127.0.0.1 --port=8000",
    "lint:backend": "composer --working-dir=backend run lint",
    "analyse:backend": "composer --working-dir=backend run analyse",
    "test:backend": "composer --working-dir=backend run test",
    "check:backend": "composer --working-dir=backend run check"
  }
}
